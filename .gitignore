# Quarto render output (published to Pages by CI, not committed)
/_site/
.quarto/

# Python
.venv/
__pycache__/
*.egg-info/
build/
dist/

# Large binary assets NEVER live in git — see README "Large files".
# Videos -> YouTube (embed). Datasets / fields -> Zenodo or Release assets (fetch via pooch).
*.mp4
*.mov
*.webm
*.vti
*.vtp
*.vtu
*.h5
*.npz
# the porous-scaling packing beds ARE the reproducibility record (tiny sphere lists, ~20 KB)
!benchmarks/porous-scaling/results/packings/*.npz
# ditto the 1.0.0 scaling deposit's unit cell, and there its raw run logs are the EVIDENCE the
# Zenodo record rests on, so they are versioned rather than ignored
!benchmarks/release-1.0.0-scaling/*.npz
!benchmarks/release-1.0.0-scaling/results/**/*.log

# NOTE: _freeze/ is intentionally NOT ignored — the frozen execution outputs
# (small PNGs + result JSON) are committed so the Pages CI can render without a GPU.

/.quarto/

# stray root render artifacts (single-file renders)
/*.html
/site_libs/

**/*.quarto_ipynb
examples/fluidized-bed/verma_frames/
benchmarks/foxberry-scaling/results/**/*.log

# run logs and frame dumps from the long solver scripts
*.log
examples/*/rivulets_*/

# TBFsolver bubble-column run directories (snapshots ~130 MB each; the case/ specs are versioned);
# run_open/ is the stopped flowCtrl 3 (open, weight-balanced) contrast run
benchmarks/bubble-column/tbfsolver/run/
benchmarks/bubble-column/tbfsolver/run_open/
benchmarks/bubble-column/tbfsolver/run150/
benchmarks/bubble-column/peclet/
