############ 1-2. load the GPU-aware toolchain (snellius_env.sh) ############
[snellius_env] GCCcore/13.3.0 GCC/13.3.0 OpenMPI/5.0.3-GCC-13.3.0 gompi/2024a CUDA/12.6.0 UCX-CUDA/1.16.0-GCCcore-13.3.0-CUDA-12.6.0 Python/3.12.3-GCCcore-13.3.0 
  loaded modules -- UCX-CUDA MUST appear here:
    UCX/1.16.0-GCCcore-13.3.0
    OpenMPI/5.0.3-GCC-13.3.0
    CUDA/12.6.0
    UCX-CUDA/1.16.0-GCCcore-13.3.0-CUDA-12.6.0

############ 3. does UCX now expose CUDA transports? ############
  #      Transport: cuda_copy
  # Memory domain: cuda_ipc
  #     Component: cuda_ipc
  #      Transport: cuda_ipc
  # Memory domain: gdr_copy
  #     Component: gdr_copy
  #      Transport: gdr_copy

############ 4. build the device-pointer MPI check ############
  built /tmp/cudampicheck

############ 5. run it on 2 ranks / 2 GPUs (DEVICE pointers) ############
  compile-time MPIX_CUDA_AWARE_SUPPORT = 1
  runtime  MPIX_Query_cuda_support()  = 1
  rank 0: sent 4096 doubles from device memory
  rank 1: device recv CORRECT -- CUDA-aware MPI works

############ verdict ############
  If you saw 'device recv CORRECT -- CUDA-aware MPI works' above, GPU-aware MPI is functional.
  Then the run scripts can set PECLET_CORE_GPU_AWARE_MPI=1 + these module/env lines.
